# ============================================================================
# PRODUCTION ENVIRONMENT TEMPLATE
# ============================================================================
# IMPORTANT: This is a TEMPLATE only. Do NOT use these values in production.
# Copy this file to .env on your production server and replace ALL placeholder
# values with real, secure values. Never commit the actual .env file.
# ============================================================================

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------
# PostgreSQL connection credentials
# IMPORTANT: Use strong, unique passwords. Do not reuse credentials.
POSTGRES_USER=your_production_postgres_user
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=clinic_db

# Full PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# For Render low-cost PostgreSQL (256 MB RAM), add ?connection_limit=5
# Example: postgresql://user:pass@your-db-host.railway.app:5432/db?connection_limit=5
DATABASE_URL=postgresql://your_production_postgres_user:your_secure_postgres_password@your-postgresql-host:5432/clinic_db?connection_limit=5

# Database connection details (used by backup service)
DB_HOST=postgres
DB_PORT=5432

# ----------------------------------------------------------------------------
# Application Configuration
# ----------------------------------------------------------------------------
NODE_ENV=production
PORT=3001

# Frontend URL for CORS (REQUIRED in production)
# This must match the actual public URL where the frontend is hosted
# Example: https://clinic.yourdomain.com
FRONTEND_URL=https://your-frontend-domain.com
# Public origin used at web build time. Keep this aligned with FRONTEND_URL.
VITE_API_URL=https://your-frontend-domain.com

# Directory containing fullchain.pem and privkey.pem for the public hostname.
# This is a host path, for example ./certificates or a prepared Certbot export.
TLS_CERT_DIR=./certificates

# ----------------------------------------------------------------------------
# Authentication Secrets (CRITICAL)
# ----------------------------------------------------------------------------
# IMPORTANT: Generate cryptographically secure random secrets for production.
# Use at least 32 characters (256 bits) for each secret.
# Do NOT use placeholder values, common passwords, or predictable strings.
#
# Generate secrets using:
#   - Node.js: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   - OpenSSL: openssl rand -hex 32
#   - Python: python3 -c "import secrets; print(secrets.token_hex(32))"
#
# JWT_SECRET: Used to sign access tokens (15 minute expiry)
JWT_SECRET=generate-a-cryptographically-secure-random-secret-at-least-32-characters

# JWT_REFRESH_SECRET: Used to sign refresh tokens (7 day expiry)
# IMPORTANT: This must be DIFFERENT from JWT_SECRET
JWT_REFRESH_SECRET=generate-a-different-cryptographically-secure-random-secret-at-least-32-characters

# ----------------------------------------------------------------------------
# Backup Configuration
# ----------------------------------------------------------------------------
# Directory where backups are stored (inside container)
BACKUP_DIR=/app/backups

# How many days of daily backups to keep locally before auto-deletion
# Recommended: 30 days for production, 14 days minimum
BACKUP_RETENTION_DAYS=30
# Base64 or hex-encoded 32-byte key. Generate and inject this secret out-of-band.
BACKUP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_REQUIRED=true

# ----------------------------------------------------------------------------
# Optional: Off-Server Backup Storage (S3-Compatible)
# ----------------------------------------------------------------------------
# Optional: Configure off-server storage for backups to protect against
# VPS failure. Any S3-compatible provider works:
#   - AWS S3
#   - Backblaze B2
#   - DigitalOcean Spaces
#   - MinIO (self-hosted)
# Leave all four blank to skip remote upload (backups stay local only)

# S3-compatible endpoint URL
# Example: https://s3.amazonaws.com or https://nyc3.digitaloceanspaces.com
BACKUP_S3_ENDPOINT=

# S3 bucket name
BACKUP_S3_BUCKET=

# S3 access credentials
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# S3 region (default: us-east-1)
BACKUP_S3_REGION=us-east-1

# ============================================================================
# SECURITY CHECKLIST BEFORE DEPLOYMENT
# ============================================================================
# [ ] All placeholder values replaced with real values
# [ ] JWT_SECRET and JWT_REFRESH_SECRET are different and cryptographically secure
# [ ] POSTGRES_PASSWORD is strong and unique
# [ ] FRONTEND_URL matches the actual production frontend domain
# [ ] DATABASE_URL uses the correct credentials
# [ ] Off-server backup storage configured (recommended for production)
# [ ] BACKUP_RETENTION_DAYS set to appropriate value (30 days recommended)
# [ ] .env file permissions set to 600 (read/write only by owner)
# [ ] SSH keys and server access are secured
# [ ] SSL/TLS configured (nginx, load balancer, or reverse proxy)
# [ ] Firewall rules restrict access to necessary ports only
# [ ] Regular backup restoration tested
# ============================================================================
