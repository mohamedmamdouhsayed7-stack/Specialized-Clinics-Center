# Database
POSTGRES_USER=clinic_user
POSTGRES_PASSWORD=clinic_password
POSTGRES_DB=clinic_db

# API
PORT=3001
NODE_ENV=development
# For Render low-cost PostgreSQL (256 MB RAM), use connection_limit=5
# Example: postgresql://user:pass@host:port/db?connection_limit=5
DATABASE_URL=postgresql://clinic_user:clinic_password@localhost:5432/clinic_db?connection_limit=5
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
# Login throttling is configured in seconds for the app, but NestJS throttler
# expects TTL values in milliseconds internally, so the app converts this value
# at runtime while preserving the safe default window. Staging can set a
# higher finite limit for automated coverage; keep production at the defaults.
AUTH_LOGIN_THROTTLE_TTL=60
AUTH_LOGIN_THROTTLE_LIMIT=10
# Only enable this in a non-production deployment whose API is exclusively
# reached through a trusted Cloudflare proxy/tunnel.
AUTH_LOGIN_THROTTLE_TRUST_PROXY=false
DEV_ADMIN_EMAIL=admin@clinic.com
DEV_ADMIN_PASSWORD=replace-with-a-strong-dev-password
DEV_RECEPTIONIST_EMAIL=receptionist@clinic.com
DEV_RECEPTIONIST_PASSWORD=replace-with-a-strong-dev-password

# Frontend
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:3001

# Backup
# How many days of daily backups to keep locally before auto-deleting them.
BACKUP_RETENTION_DAYS=14
# Base64 or hex-encoded 32-byte key. Required in production.
BACKUP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_REQUIRED=false
# Optional: off-server storage for backups (any S3-compatible provider —
# AWS S3, Backblaze B2, DigitalOcean Spaces, MinIO, etc). Leave all four
# blank to skip remote upload; backups still work, they just stay local
# only (at ./backups on the host).
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=us-east-1
