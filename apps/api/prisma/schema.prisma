// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  RECEPTIONIST
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  DONE
  CANCELLED
  NO_SHOW
}

enum VisitType {
  CHECKUP
  FOLLOW_UP
  OTHER
}

enum VisitStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  VOID
}

enum InvoicePaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum ChargeType {
  PERCENTAGE
  FIXED
}

enum PaymentMethod {
  CASH
  VISA
  KNET
  LINK
  OTHER
}

enum PaymentStatus {
  RECORDED
  REVERSED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    User?    @relation("UserHierarchy", fields: [createdById], references: [id], onDelete: SetNull)

  createdById String? @db.Uuid

  // Relations
  createdUsers        User[]           @relation("UserHierarchy")
  createdPatients      Patient[]       @relation("UserCreatedBy")
  createdAppointments Appointment[]    @relation("UserCreatedBy")
  createdVisits        Visit[]          @relation("UserCreatedBy")
  createdInvoices      Invoice[]        @relation("UserCreatedBy")
  issuedInvoices       Invoice[]        @relation("UserIssuedBy")
  recordedPayments     Payment[]        @relation("UserRecordedBy")
  createdServices      Service[]        @relation("UserCreatedBy")
  auditLogs            AuditLog[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@index([email])
}

model Patient {
  id          String   @id @default(uuid()) @db.Uuid
  civilId     String?  @unique
  fullNameAr  String
  fullNameEn  String?
  phone       String?
  dateOfBirth DateTime?
  address     String?
  legacySource      String?
  legacyPatientKey  String?
  legacyReference   String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User?    @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdById String? @db.Uuid

  // Relations
  appointments Appointment[] @relation("PatientAppointments")
  visits       Visit[]       @relation("PatientVisits")
  invoices     Invoice[]    @relation("PatientInvoices")

  @@index([civilId])
  @@index([fullNameAr])
  @@index([fullNameEn])
  @@index([phone])
  @@index([legacySource, legacyPatientKey])
}

model Appointment {
  id           String            @id @default(uuid()) @db.Uuid
  patientId    String            @db.Uuid
  scheduledAt  DateTime
  status       AppointmentStatus
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  createdBy    User?             @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdById String? @db.Uuid

  // Relations
  patient Patient @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Restrict)
  visit   Visit?  @relation("AppointmentVisit")

  @@index([patientId, scheduledAt])
  @@index([scheduledAt])
  @@index([status])
}

model Visit {
  id            String   @id @default(uuid()) @db.Uuid
  patientId     String   @db.Uuid
  appointmentId String?  @unique @db.Uuid
  type          VisitType
  status        VisitStatus @default(SCHEDULED)
  visitDate     DateTime @default(now())
  notes         String?
  diagnosis     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     User?    @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdById String? @db.Uuid

  // Relations
  patient     Patient   @relation("PatientVisits", fields: [patientId], references: [id], onDelete: Restrict)
  appointment Appointment? @relation("AppointmentVisit", fields: [appointmentId], references: [id], onDelete: SetNull)
  invoices    Invoice[] @relation("VisitInvoices")

  @@index([patientId, visitDate])
  @@index([appointmentId])
  @@index([visitDate])
}

model Service {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  code         String?  @unique
  description  String?
  currentPrice Decimal  @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    User?    @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdById String? @db.Uuid

  // Relations
  invoiceItems InvoiceItem[]

  @@index([isActive])
}

model Invoice {
  id                  String              @id @default(uuid()) @db.Uuid
  invoiceNumber       String              @unique
  visitId             String              @db.Uuid
  patientId           String              @db.Uuid
  status              InvoiceStatus       @default(DRAFT)
  subtotal            Decimal             @default(0) @db.Decimal(10, 2)
  total               Decimal             @default(0) @db.Decimal(10, 2)
  paid                Decimal             @default(0) @db.Decimal(10, 2)
  remaining           Decimal             @default(0) @db.Decimal(10, 2)
  paymentStatus       InvoicePaymentStatus @default(UNPAID)
  issuedAt            DateTime?
  issuedBy            User?               @relation("UserIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  replacedByInvoiceId String?             @db.Uuid
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  createdBy           User?               @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  issuedById   String? @db.Uuid
  createdById  String? @db.Uuid

  // Relations
  visit              Visit                   @relation("VisitInvoices", fields: [visitId], references: [id], onDelete: Restrict)
  patient             Patient                 @relation("PatientInvoices", fields: [patientId], references: [id], onDelete: Restrict)
  invoiceItems       InvoiceItem[]
  additionalCharges   InvoiceAdditionalCharge[]
  payments           Payment[]
  paymentAllocations PaymentAllocation[]
  replacedByInvoice   Invoice?               @relation("InvoiceReplacement", fields: [replacedByInvoiceId], references: [id], onDelete: SetNull)
  replacementInvoices Invoice[]               @relation("InvoiceReplacement")

  @@index([patientId])
  @@index([status])
  @@index([issuedAt])
  @@index([paymentStatus])
  // Partial unique index enforced via migration: at most one active (DRAFT or ISSUED) invoice per visit
  // See migration: 20260906090000_add_one_active_invoice_per_visit_constraint
}

model InvoiceItem {
  id                 String   @id @default(uuid()) @db.Uuid
  invoiceId          String   @db.Uuid
  serviceId          String?  @db.Uuid
  serviceNameSnapshot String
  unitPriceSnapshot  Decimal  @db.Decimal(10, 2)
  quantity           Int      @default(1)
  lineTotal          Decimal  @db.Decimal(10, 2)
  createdAt          DateTime @default(now())

  // Relations
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

model InvoiceAdditionalCharge {
  id              String     @id @default(uuid()) @db.Uuid
  invoiceId       String     @db.Uuid
  chargeType      ChargeType
  chargeValue     Decimal    @db.Decimal(10, 2)
  calculatedAmount Decimal   @db.Decimal(10, 2)
  description     String?
  createdAt       DateTime   @default(now())

  // Relations
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  invoiceId       String        @db.Uuid
  amount          Decimal       @db.Decimal(10, 2)
  method          PaymentMethod
  status          PaymentStatus @default(RECORDED)
  paymentDate     DateTime      @default(now())
  notes           String?
  reversedAt      DateTime?
  reversedBy      String?       @db.Uuid
  reversalNotes   String?
  createdAt       DateTime      @default(now())
  recordedBy      User?         @relation("UserRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  recordedById String? @db.Uuid

  // Relations
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  allocations PaymentAllocation[]

  @@index([invoiceId])
  @@index([paymentDate])
  @@index([method])
  @@index([status])
}

// A replacement never owns a historical payment.  This immutable allocation
// records the amount of a source payment that credits the replacement, so a
// later reversal can remove that credit without losing the payment history.
model PaymentAllocation {
  id        String   @id @default(uuid()) @db.Uuid
  paymentId String   @db.Uuid
  invoiceId String   @db.Uuid
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
  @@index([paymentId])
}

model RefreshToken {
  id           String   @id @default(uuid()) @db.Uuid
  token        String   @unique
  userId       String   @db.Uuid
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("RefreshToken")
}

model PasswordResetToken {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String
  userId     String   @db.Uuid
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("PasswordResetToken")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  action     String
  entityType String
  entityId   String
  beforeState Json?
  afterState  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
